<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="28dp">

        <!-- 顶部 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                style="@style/LinkText"
                android:paddingStart="0dp"
                android:paddingEnd="8dp"
                android:text="‹ 返回" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="设置"
                android:textColor="@color/text_main"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:text="改完即时生效，不用重启"
            android:textColor="@color/text_faint"
            android:textSize="12sp" />

        <!-- ① 打卡时间 -->
        <TextView style="@style/SectionHead" android:text="打卡时间" />

        <LinearLayout style="@style/CardBox">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="上班窗口固定；下班开始时间按今天上班实际打卡时间顺延，截止时间用下面自己设的值（不顺延）"
                android:textColor="@color/text_faint"
                android:textSize="12sp" />

            <View style="@style/Divider" />

            <LinearLayout android:id="@+id/rowInStart" style="@style/Row">
                <TextView style="@style/RowLabel" android:text="上班窗口开始" />
                <TextView android:id="@+id/tvInStart" style="@style/RowValue" android:text="09:00" />
                <TextView style="@style/Chevron" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout android:id="@+id/rowInEnd" style="@style/Row">
                <TextView style="@style/RowLabel" android:text="上班窗口结束" />
                <TextView android:id="@+id/tvInEnd" style="@style/RowValue" android:text="10:00" />
                <TextView style="@style/Chevron" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout android:id="@+id/rowOutStart" style="@style/Row">
                <TextView style="@style/RowLabel" android:text="下班窗口开始" />
                <TextView android:id="@+id/tvOutStart" style="@style/RowValue" android:text="18:00" />
                <TextView style="@style/Chevron" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout android:id="@+id/rowOutEnd" style="@style/Row">
                <TextView style="@style/RowLabel" android:text="下班窗口结束" />
                <TextView android:id="@+id/tvOutEnd" style="@style/RowValue" android:text="19:00" />
                <TextView style="@style/Chevron" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout android:id="@+id/rowLeadIn" style="@style/Row">
                <TextView style="@style/RowLabel" android:text="上班提醒" />
                <TextView android:id="@+id/tvLeadIn" style="@style/RowValue" android:text="提前 5 分钟" />
                <TextView style="@style/Chevron" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout android:id="@+id/rowLeadOut" style="@style/Row">
                <TextView style="@style/RowLabel" android:text="下班提醒" />
                <TextView android:id="@+id/tvLeadOut" style="@style/RowValue" android:text="窗口开启时" />
                <TextView style="@style/Chevron" />
            </LinearLayout>
        </LinearLayout>

        <!-- ② 打卡方式 -->
        <TextView style="@style/SectionHead" android:text="打卡方式" />

        <LinearLayout style="@style/CardBox">

            <RadioGroup
                android:id="@+id/rgMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbAuto"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="自动打卡（到点自动打开飞书并点击打卡）"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbRemind"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="仅提醒（弹通知，由我自己点）"
                    android:textSize="14sp" />
            </RadioGroup>

            <TextView style="@style/NoteText" android:text="仅提醒模式下，若无障碍已开启，你在飞书里打完卡后 App 仍会识别结果并提示、记账。" />

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="隐藏后台任务"
                        android:textColor="@color/text_main"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="不在最近任务里出现，也不会被一键划掉"
                        android:textColor="@color/text_faint"
                        android:textSize="11sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swHideTask"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- ③ 打卡后的反馈 -->
        <TextView style="@style/SectionHead" android:text="打卡后的反馈" />

        <LinearLayout style="@style/CardBox">

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="提示音" />
                <Switch android:id="@+id/swSound" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout android:id="@+id/rowSoundStyle" style="@style/Row">
                <TextView style="@style/RowLabel" android:text="提示音音效" />
                <TextView android:id="@+id/tvSoundStyle" style="@style/RowValue" android:text="经典叮咚" />
                <TextView android:id="@+id/btnSoundTest" style="@style/LinkText" android:text="听一下" />
                <TextView style="@style/Chevron" />
            </LinearLayout>

            <TextView style="@style/NoteText" android:text="点开后逐个试听，选哪个就用哪个；提示音和语音播报都受上面「播报音量」控制。" />

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="语音播报" />
                <Switch android:id="@+id/swVoice" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="播报音量" />
                <TextView android:id="@+id/tvVoiceVolume" style="@style/RowValue" android:text="100%" />
                <TextView android:id="@+id/btnVoiceTest" style="@style/LinkText" android:text="试听" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbVoiceVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView style="@style/NoteText" android:text="只调本 App 自己播报的音量，系统音量不动；范围 0~1000%，超过 100% 会整体放大波形，越大越容易发闷，按听感自己调。" />

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="震动" />
                <Switch android:id="@+id/swVibrate" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="屏幕中央提示" />
                <Switch android:id="@+id/swOverlay" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout android:id="@+id/rowTipSeconds" style="@style/Row">
                <TextView style="@style/RowLabel" android:text="提示停留时长" />
                <TextView android:id="@+id/tvTipSeconds" style="@style/RowValue" android:text="5 秒" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbTipSeconds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                android:max="19" />

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="识别飞书里的打卡结果"
                        android:textColor="@color/text_main"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="你手动打完卡，App 也会提示、记账并发通知"
                        android:textColor="@color/text_faint"
                        android:textSize="11sp" />
                </LinearLayout>

                <Switch android:id="@+id/swWatch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- ④ 工作日日历 -->
        <TextView style="@style/SectionHead" android:text="工作日日历" />

        <LinearLayout style="@style/CardBox">

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="日历来源" />
                <TextView android:id="@+id/tvCalendarSource" style="@style/RowValue" android:text="内置 2025–2027 + 联网" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout android:id="@+id/rowSyncCalendar" style="@style/Row">
                <TextView style="@style/RowLabel" android:text="联网同步" />
                <TextView android:id="@+id/tvSyncStatus" style="@style/RowValue" android:text="未同步" />
                <TextView android:id="@+id/btnSyncCalendar" style="@style/LinkText" android:text="同步" />
            </LinearLayout>

            <TextView style="@style/NoteText" android:text="打开 App 时七天自动同步一次；节假日、调休补班都跟官方通知走。" />

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="今天" />
                <TextView android:id="@+id/tvTodayState" style="@style/RowValue" android:text="工作日" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout android:id="@+id/rowAddRest" style="@style/Row">
                <TextView style="@style/RowLabel" android:text="手动加休息日" />
                <TextView android:id="@+id/tvRestDates" style="@style/RowValue" android:text="无" />
                <TextView style="@style/LinkText" android:text="添加" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout android:id="@+id/rowAddWork" style="@style/Row">
                <TextView style="@style/RowLabel" android:text="手动加上班日" />
                <TextView android:id="@+id/tvWorkDates" style="@style/RowValue" android:text="无" />
                <TextView style="@style/LinkText" android:text="添加" />
            </LinearLayout>

            <TextView style="@style/NoteText" android:text="手动标记优先级最高，适合公司自有假期或地方调休；长按那一行可以删除已加的日期。" />

            <View style="@style/Divider" />

            <TextView
                android:id="@+id/btnClearCalendar"
                style="@style/LinkText"
                android:layout_gravity="center_horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="清空手动标记" />
        </LinearLayout>

        <!-- ⑤ 权限与后台 -->
        <TextView style="@style/SectionHead" android:text="权限与后台" />

        <LinearLayout style="@style/CardBox">

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="无障碍服务" />
                <TextView android:id="@+id/tvAccStatus" style="@style/RowValue" android:text="未开启" />
                <TextView android:id="@+id/btnAcc" style="@style/LinkText" android:text="开启" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="悬浮窗" />
                <TextView android:id="@+id/tvOverlayStatus" style="@style/RowValue" android:text="未授权" />
                <TextView android:id="@+id/btnOverlay" style="@style/LinkText" android:text="授权" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="精确闹钟" />
                <TextView android:id="@+id/tvExactStatus" style="@style/RowValue" android:text="未授权" />
                <TextView android:id="@+id/btnExact" style="@style/LinkText" android:text="授权" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="通知权限" />
                <TextView android:id="@+id/tvNotifStatus" style="@style/RowValue" android:text="未开启" />
                <TextView android:id="@+id/btnNotif" style="@style/LinkText" android:text="开启" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="Shizuku / Shevery" />
                <TextView android:id="@+id/tvShizukuStatus" style="@style/RowValue" android:text="未运行" />
                <TextView android:id="@+id/btnShizuku" style="@style/LinkText" android:text="授权" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="电池优化" />
                <TextView android:id="@+id/tvBatteryStatus" style="@style/RowValue" android:text="未忽略" />
                <TextView android:id="@+id/btnBattery" style="@style/LinkText" android:text="设置" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="打卡通道" />
                <TextView android:id="@+id/tvChannelStatus" style="@style/RowValue" android:text="未开启" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout android:id="@+id/rowKeepAlive" style="@style/Row">
                <TextView style="@style/RowLabel" android:text="保活状态" />
                <TextView android:id="@+id/tvKeepStatus" style="@style/RowValue" android:text="待唤醒" />
                <TextView style="@style/Chevron" />
            </LinearLayout>

            <TextView style="@style/NoteText" android:text="用 Shevery 的话，先打开兼容存根（Compatibility Stubs），官方 Shizuku 授权弹窗才会出现；不开也能用无障碍通道。" />
        </LinearLayout>

        <!-- ⑥ 飞书页面识别 -->
        <TextView style="@style/SectionHead" android:text="飞书页面识别" />

        <TextView style="@style/SectionNote" android:text="进阶项，飞书改版后识别不到按钮时再动" />

        <LinearLayout style="@style/CardBox">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="进打卡页的点击路径（用 &gt; 分隔）"
                android:textColor="@color/text_sub"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etNavPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="工作台&gt;打卡"
                android:inputType="text"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="上班打卡按钮文字（用 | 分隔）"
                android:textColor="@color/text_sub"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etInBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="上班打卡|打卡"
                android:inputType="text"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="下班打卡按钮文字（用 | 分隔）"
                android:textColor="@color/text_sub"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etOutBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="下班打卡|打卡"
                android:inputType="text"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <TextView style="@style/NoteText" android:text="飞书包名 com.ss.android.lark，一般不用改" />
        </LinearLayout>

        <!-- ⑦ 测试与调试 -->
        <TextView style="@style/SectionHead" android:text="测试与调试" />

        <LinearLayout android:id="@+id/rowTest" style="@style/CardBox">

            <LinearLayout style="@style/Row">

                <TextView style="@style/RowLabel" android:text="场景模拟 / 手动补卡 / 真机跑一次" />

                <TextView style="@style/Chevron" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
