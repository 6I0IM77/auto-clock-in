<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                style="@style/LinkText"
                android:text="‹ 返回" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="测试与调试"
                android:textColor="@color/text_main"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="      "
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            style="@style/SectionHead"
            android:text="手动补卡" />

        <LinearLayout style="@style/CardBox">

            <LinearLayout android:id="@+id/rowPickDate" style="@style/Row">
                <TextView style="@style/RowLabel" android:text="日期" />
                <TextView android:id="@+id/tvPickDate" style="@style/RowValue" android:text="今天" />
                <TextView style="@style/Chevron" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout android:id="@+id/rowInTime" style="@style/Row">
                <TextView style="@style/RowLabel" android:text="上班时间" />
                <TextView android:id="@+id/tvInTime" style="@style/RowValue" android:text="不补" />
                <TextView style="@style/Chevron" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout android:id="@+id/rowOutTime" style="@style/Row">
                <TextView style="@style/RowLabel" android:text="下班时间" />
                <TextView android:id="@+id/tvOutTime" style="@style/RowValue" android:text="不补" />
                <TextView style="@style/Chevron" />
            </LinearLayout>

            <TextView style="@style/NoteText" android:text="某天忘了用 App 打卡、或人在外面没开飞书时，在这里补上时间即可；写入后主页的日历、双卡数和本周出勤会立刻跟着变。" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnWriteRecord"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary"
                    android:gravity="center"
                    android:text="写入记录"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnClearRecord"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:gravity="center"
                    android:text="清空这天"
                    android:textColor="@color/text_main"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWriteHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_faint"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="模拟场景（不写打卡记录，也不点飞书）" />

        <LinearLayout style="@style/CardBox">

            <LinearLayout
                android:id="@+id/layoutScenarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="每个场景都会用假时钟 + 假记录走一遍真实判定：该打卡时看声音、语音、中央提示和通知栏「打卡成功」；不该打卡时看提示文案和置灰状态。"
                android:textColor="@color/text_faint"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="真机调试（会真的去点飞书）" />

        <LinearLayout style="@style/CardBox">

            <TextView
                android:id="@+id/btnRunIn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:text="现在就跑一次「上班打卡」"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="会真的打开飞书点一卡，可能写入今天的记录。第一次用建议先在上面几个场景里确认提示正常，再点这里盯着屏幕看它有没有点中。"
                android:textColor="@color/text_faint"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
